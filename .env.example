# =============================================================================
#  Paypilot AI / PayScore API configuration
# =============================================================================
#  Copy this file to `.env` in the repository root. The API loads it at startup.
#
#  Demo mode needs NO configuration: with an empty .env the API serves the
#  synthetic personas, the trained model, Offer Guard, and the copilot, and
#  payouts, subscriptions, and checkout run in a labelled SIMULATED mode.
#  Fill in section 1 to use the real PayPal sandbox instead.
#
#  Sandbox only: the PayPal client refuses live mode. Never commit a real .env.
#  The frontend has its own file: frontend/.env.example.
# =============================================================================


# -----------------------------------------------------------------------------
#  1. MUST CONFIGURE for PayPal sandbox features
#     (Log in with PayPal, live income profile, payouts, repayment checkout)
# -----------------------------------------------------------------------------

# Sandbox app credentials. How to create them: docs/SANDBOX_SETUP.md
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Keep as sandbox. Live mode is rejected.
PAYPAL_MODE=sandbox

# Where the frontend runs. PayPal login returns here, and Income Passport PDFs
# link to <this URL>/verify/income-passport/<token>.
PAYSCORE_FRONTEND_URL=http://localhost:5173

# Browser origins allowed to call the API (comma-separated). Add your deployed
# frontend URL here. "*" allows any origin (avoid outside local demos); an empty
# value disables CORS headers entirely.
PAYSCORE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173


# =============================================================================
#  ADVANCED CONFIGURATION
#  The defaults below work as-is. Change them only when you need to.
# =============================================================================


# -----------------------------------------------------------------------------
#  2. PayPal sandbox details
# -----------------------------------------------------------------------------

# Webhook id for signature verification (docs/SANDBOX_SETUP.md, step 3).
PAYPAL_WEBHOOK_ID=

# Leave empty to use https://api-m.sandbox.paypal.com.
PAYPAL_API_BASE=

# Must exactly match the callback URL registered in your PayPal app.
PAYPAL_OAUTH_REDIRECT_URI=http://localhost:8000/oauth/callback

# Demo-only INR-to-USD rate for repayment APIs (PayPal Subscriptions has no INR).
PAYPAL_INR_PER_USD=83.00

# Without credentials, payouts, subscriptions, and checkout return labelled simulated
# results (ids start with SIM-, no PayPal call). "off" returns 503 instead.
PAYSCORE_PAYPAL_SIMULATION=auto

# Where PayPal checkout returns after approval or cancellation.
PAYSCORE_RETURN_URL=http://localhost:5173/repayment/return
PAYSCORE_CANCEL_URL=http://localhost:5173/repayment/cancel


# -----------------------------------------------------------------------------
#  3. Model and scoring
# -----------------------------------------------------------------------------

PAYSCORE_MODEL_DIR=./models

# true:  with no trained model, serve the clearly labelled DEVELOPMENT FALLBACK.
# false: POST /score returns 503 instead.
PAYSCORE_ALLOW_FALLBACK=true


# -----------------------------------------------------------------------------
#  4. Feature behaviour
# -----------------------------------------------------------------------------

# Hardship agent: days without a PayPal capture before a case is flagged and a
# payment-holiday or lower revenue-share offer is drafted.
PAYSCORE_HARDSHIP_GAP_DAYS=14

# Block extraction (and any LLM) when an uploaded offer PDF hides adversarial
# prompt-injection text. Keep on.
PAYSCORE_PDF_INJECTION_GUARD=true

# Live download of the RBI digital-lending app list. false makes no outbound
# request; with the empty snapshot in reference/, the lender check stays "unverified".
PAYSCORE_RBI_FETCH=false

# HMAC-SHA256 key that signs Income Passport contents so tampering is detected.
# Empty: verification still checks the random token, without a content signature.
# Use a long random value in production, and never commit it.
PAYSCORE_PASSPORT_SIGNING_KEY=

# Dispute helper: JSON-RPC endpoint that lists open chargebacks.
# Empty: a labelled local sample dispute is used.
DISPUTES_MCP_ENDPOINT=


# -----------------------------------------------------------------------------
#  5. Optional LLM features (all OFF by default)
#     Each feature needs BOTH of its flags set to true before any text leaves
#     this machine. Use them only with synthetic or public samples, never with
#     private financial documents.
# -----------------------------------------------------------------------------

# Shared OpenAI-compatible provider, used by Offer Guard and the dispute helper.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Offer Guard: LLM-assisted extraction of loan terms from PDFs.
PAYSCORE_OFFER_LLM=false
PAYSCORE_OFFER_LLM_ALLOW_EXTERNAL=false

# Dispute helper: LLM-written chargeback responses.
DISPUTES_LLM=false
DISPUTES_LLM_ALLOW_EXTERNAL=false

# Hardship agent: LLM-written relief offers (uses OPENAI_API_KEY).
HARDSHIP_LLM=false
HARDSHIP_LLM_ALLOW_EXTERNAL=false
HARDSHIP_LLM_MODEL=gpt-4o-mini
HARDSHIP_LLM_BASE_URL=https://api.openai.com/v1
