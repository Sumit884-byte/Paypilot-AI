# Copy to .env if you use a dotenv loader / process manager. No secrets are needed for Week 1.
PAYSCORE_MODEL_DIR=./models
# true -> if no trained model exists, serve the clearly-labelled DEVELOPMENT FALLBACK; false -> POST /score returns 503
PAYSCORE_ALLOW_FALLBACK=true
# Comma-separated allowed browser origins. Default is local dev only. "*" allows any origin (avoid outside local demos).
# An empty value disables CORS headers entirely.
PAYSCORE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# --- PayPal sandbox (see docs/SANDBOX_SETUP.md). Sandbox ONLY; the client refuses live mode. ---
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox
# Webhook id for signature verification (optional; see docs/SANDBOX_SETUP.md step 3)
PAYPAL_WEBHOOK_ID=
# Leave unset to default to https://api-m.sandbox.paypal.com
PAYPAL_API_BASE=
# Must exactly match the callback URL registered in the PayPal app.
PAYPAL_OAUTH_REDIRECT_URI=http://localhost:8000/paypal/auth/callback
# Demo-only INR-to-USD conversion used for repayment APIs (PayPal Subscriptions does not support INR).
PAYPAL_INR_PER_USD=83.00
PAYSCORE_RETURN_URL=http://localhost:5173/repayment/return
PAYSCORE_CANCEL_URL=http://localhost:5173/repayment/cancel
# Browser OAuth returns here after GET /paypal/auth/callback (JSON clients are unchanged).
PAYSCORE_FRONTEND_URL=http://localhost:5173
# HMAC-SHA256 key for Income Passport content integrity. Leave empty to skip content signatures
# (verification still uses the random token hash). Never commit a real production secret.
PAYSCORE_PASSPORT_SIGNING_KEY=
# Offer-guard LLM stays off unless both flags are true. Document text is sent to the provider only then.
# Use that path only for synthetic or public offer samples, never for private financial documents.
PAYSCORE_OFFER_LLM=false
PAYSCORE_OFFER_LLM_ALLOW_EXTERNAL=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
# Live retrieval of the RBI digital-lending-app page. Leave false unless you accept an outbound request.
# An empty reference/rbi_dla_snapshot.json means the directory check stays unverified.
PAYSCORE_RBI_FETCH=false
# Hardship agent: income gap (days) with no PayPal capture that flags a case and
# triggers a payment-holiday / lower-revenue-share draft (Person A, Task 1).
PAYSCORE_HARDSHIP_GAP_DAYS=14
# PDF prompt-injection guard: block extraction/LLM when adversarial text is found
# in an uploaded offer PDF (Person A, Task 2). On by default.
PAYSCORE_PDF_INJECTION_GUARD=true
# Dispute helper (Person A, Task 3): optional MCP server that lists open chargebacks.
# When unset, a labeled local fallback is used.
DISPUTES_MCP_ENDPOINT=
# Dispute-response LLM stays off unless both flags are true.
DISPUTES_LLM=false
DISPUTES_LLM_ALLOW_EXTERNAL=false
# Hardship relief LLM stays off unless both flags are true (Person A, Task 1).
HARDSHIP_LLM=false
HARDSHIP_LLM_ALLOW_EXTERNAL=false
HARDSHIP_LLM_MODEL=gpt-4o-mini
HARDSHIP_LLM_BASE_URL=https://api.openai.com/v1
